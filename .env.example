# Copy this file to .env, then replace provider placeholders locally.
# Never commit .env. OpenAI-compatible chat, structured-output, and embedding
# endpoints may be supplied by the same provider or by separate providers.

# Chat / function calling
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-chat-model

# Structured output (key and base URL both blank => inherit the LLM_* pair)
STRUCTURED_API_KEY=
STRUCTURED_BASE_URL=
STRUCTURED_MODEL=

# Embeddings (key and base URL both blank => inherit the LLM_* pair)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=replace-with-embedding-model

# Provider catalog health check. It never sends chat or embedding requests.
PROVIDER_HEALTH_TIMEOUT_SECONDS=5
PROVIDER_HEALTH_TTL_SECONDS=30
# End-to-end budget for centralized retrying provider calls, including backoff.
PROVIDER_REQUEST_DEADLINE_SECONDS=60
# Explicit CLI capability probes may make billable requests.
PROVIDER_CAPABILITY_TIMEOUT_SECONDS=30

# Local data and upload limits
CHROMA_DIR=./chroma_db
MAX_UPLOAD_MB=20
STAGING_COLLECTION_TTL_SECONDS=3600
# Embedded Chroma calls run through one daemon worker. These bounds cap callers
# waiting to enter, the admitted backlog, cancellation hand-off, and one call's
# public response time; an already-started write keeps draining safely.
CHROMA_IO_MAX_PENDING=16
CHROMA_IO_QUEUE_WAIT_SECONDS=10
CHROMA_IO_OPERATION_TIMEOUT_SECONDS=30
CHROMA_IO_CANCEL_DRAIN_SECONDS=2
CHROMA_IO_SHUTDOWN_DRAIN_SECONDS=5
DATABASE_URL=
# The supported bundled topology is one backend worker/replica because it uses
# an embedded Chroma PersistentClient. DATABASE_URL makes durable state stores
# cross-process capable, but does not make embedded Chroma multi-process safe.
# Do not set WEB_CONCURRENCY above 1; a future multi-worker deployment must use
# an external Chroma server/HttpClient as well as PostgreSQL.
# With no DATABASE_URL, learner memory also uses one in-process store plus this
# JSON snapshot.
# Learner-memory PostgreSQL uses a temporary schema-setup connection followed by
# one long-lived runtime connection. These settings bound connection and server
# waits plus queue/cancellation cleanup; they do not add pool-based hot recovery.
MEMORY_STORE_PG_CONNECT_TIMEOUT_SECONDS=5
MEMORY_STORE_PG_LOCK_TIMEOUT_MS=5000
MEMORY_STORE_PG_STATEMENT_TIMEOUT_MS=30000
# Schema setup has a separate, longer statement budget because it may build an
# index concurrently. Invalid interrupted indexes are repaired on the next start.
MEMORY_STORE_PG_SETUP_STATEMENT_TIMEOUT_SECONDS=300
MEMORY_STORE_PG_TCP_USER_TIMEOUT_MS=30000
# Runtime Store calls are serialized before entering the thread executor. A
# queued request and cancellation cleanup each have their own finite budget.
MEMORY_STORE_PG_IO_WAIT_TIMEOUT_SECONDS=30
MEMORY_STORE_PG_CANCEL_DRAIN_TIMEOUT_SECONDS=35
# Maximum time spent waiting for another process to finish learner-memory schema
# setup. Individual connection, lock, and statement waits remain bounded above.
MEMORY_STORE_SETUP_LOCK_TIMEOUT_SECONDS=300
# Upper bound for one user's cross-worker session-write/archive lock.
MEMORY_SESSION_ARCHIVE_LOCK_TIMEOUT_SECONDS=10
MEMORY_SNAPSHOT_PATH=./.memory_snapshot.json
# Durable replay receipts, Learning Paths, Web Quiz/Adaptive sessions, and
# Autonomous pause snapshots use PostgreSQL when DATABASE_URL is set. Locally they share this
# SQLite file unless a feature-specific path override is set.
IDEMPOTENCY_DB_PATH=./.idempotency.sqlite3
IDEMPOTENCY_RECEIPT_LEASE_SECONDS=600
IDEMPOTENCY_PG_CONNECT_TIMEOUT_SECONDS=5
IDEMPOTENCY_PG_LOCK_TIMEOUT_MS=5000
IDEMPOTENCY_PG_STATEMENT_TIMEOUT_MS=15000
IDEMPOTENCY_PG_TCP_USER_TIMEOUT_MS=30000
IDEMPOTENCY_SCHEMA_INIT_WAIT_TIMEOUT_SECONDS=30
IDEMPOTENCY_CANCEL_DRAIN_TIMEOUT_SECONDS=20
LEARNING_PATH_DB_PATH=
LEARNING_PATH_MAX_PAYLOAD_BYTES=1048576
LEARNING_PATH_SQLITE_BUSY_TIMEOUT_MS=10000
LEARNING_PATH_PG_CONNECT_TIMEOUT_SECONDS=5
LEARNING_PATH_PG_LOCK_TIMEOUT_MS=5000
LEARNING_PATH_PG_STATEMENT_TIMEOUT_MS=15000
LEARNING_PATH_PG_TCP_USER_TIMEOUT_MS=30000
LEARNING_PATH_SCHEMA_INIT_WAIT_TIMEOUT_SECONDS=30
LEARNING_PATH_CANCEL_DRAIN_TIMEOUT_SECONDS=20
QUIZ_SESSION_DB_PATH=
QUIZ_SESSION_TTL_SECONDS=86400
QUIZ_SESSION_OPERATION_LEASE_SECONDS=600
QUIZ_SESSION_MAX_COUNT=500
QUIZ_SESSION_MAX_PAYLOAD_BYTES=2097152
QUIZ_SESSION_PG_CONNECT_TIMEOUT_SECONDS=5
QUIZ_SESSION_PG_LOCK_TIMEOUT_MS=5000
QUIZ_SESSION_PG_STATEMENT_TIMEOUT_MS=15000
QUIZ_SESSION_SCHEMA_INIT_WAIT_TIMEOUT_SECONDS=30
QUIZ_SESSION_CANCEL_DRAIN_TIMEOUT_SECONDS=20
ADAPTIVE_SESSION_DB_PATH=
ADAPTIVE_SESSION_TTL_SECONDS=3600
ADAPTIVE_SESSION_OPERATION_LEASE_SECONDS=600
ADAPTIVE_SESSION_MAX_COUNT=200
ADAPTIVE_SESSION_MAX_PAYLOAD_BYTES=2097152
ADAPTIVE_SESSION_PG_CONNECT_TIMEOUT_SECONDS=5
ADAPTIVE_SESSION_PG_LOCK_TIMEOUT_MS=5000
ADAPTIVE_SESSION_PG_STATEMENT_TIMEOUT_MS=15000
ADAPTIVE_SESSION_PG_TCP_USER_TIMEOUT_MS=30000
ADAPTIVE_SESSION_SCHEMA_INIT_WAIT_TIMEOUT_SECONDS=30
ADAPTIVE_SESSION_CANCEL_DRAIN_TIMEOUT_SECONDS=20
AUTONOMOUS_SESSION_DB_PATH=
AUTONOMOUS_SESSION_TTL_SECONDS=3600
AUTONOMOUS_SESSION_OPERATION_LEASE_SECONDS=600
AUTONOMOUS_SESSION_MAX_COUNT=200
AUTONOMOUS_SESSION_MAX_PAYLOAD_BYTES=2097152
AUTONOMOUS_SESSION_PG_CONNECT_TIMEOUT_SECONDS=5
AUTONOMOUS_SESSION_PG_LOCK_TIMEOUT_MS=5000
AUTONOMOUS_SESSION_PG_STATEMENT_TIMEOUT_MS=15000
AUTONOMOUS_SESSION_PG_TCP_USER_TIMEOUT_MS=30000
AUTONOMOUS_SESSION_SCHEMA_INIT_WAIT_TIMEOUT_SECONDS=30
AUTONOMOUS_SESSION_CANCEL_DRAIN_TIMEOUT_SECONDS=20
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_PATH=./.checkpoints/orchestrator.db

# Retrieval features. Keep optional network/model-heavy stages off for first run.
QUERY_REWRITE_ENABLED=false
HYDE_ENABLED=false
MULTIQUERY_ENABLED=false
MULTIQUERY_N=3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Workflow switches
CRITIC_ENABLED=true
REVISER_ENABLED=true
PATH_REVISER_ENABLED=true
ONESHOT_QUIZ_CRITIC=true
# Experimental API-only supervisor graph. It has no Web UI and its pure tutor
# worker is unfinished. Keep false outside focused development/testing.
MAS_SUPERVISOR_ENABLED=false
SUPERVISOR_MODE=llm

# Prompt-injection classifier; blank means regex-only checks.
INJECTION_LLM_CHECK=

# Full audit payloads may contain user queries and retrieved document text.
# Keep disabled unless the API is restricted to a trusted environment.
AUDIT_PAYLOAD_ENABLED=false

# Optional live MCP tools. Disabled by default because they may access networks.
MCP_LIVE_ENABLED=false
UVX_PATH=uvx

# Optional tracing. Both integrations are disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=study-loop
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Blank uses the SDK cloud default and preserves legacy LANGFUSE_HOST fallback.
LANGFUSE_BASE_URL=

# Docker Compose database settings. POSTGRES_PASSWORD is required by Compose.
POSTGRES_USER=studyloop
POSTGRES_PASSWORD=
POSTGRES_DB=studyloop

# BM25 索引缓存的内存预算（缓存正文总字符数）。缓存持有每个查询过的文档的
# 全部 chunk 正文，超出后按最久未用淘汰。单个文档超预算时仍保留一条。
BM25_CACHE_MAX_CHARS=5000000

# 访问令牌。设置后所有业务端点都要求 Authorization: Bearer <token>；
# 至少 16 个字符，太短会让进程拒绝启动。
# 留空则是匿名单用户模式：每个调用方都被当成同一个默认用户。这方便本地开发，
# 但**不是**访问控制边界——/health/live 会如实报告当前处于哪种模式。
STUDYLOOP_AUTH_TOKEN=
