# Copy this file to .env, then replace provider placeholders locally.
# Never commit .env. OpenAI-compatible chat, structured-output, and embedding
# endpoints may be supplied by the same provider or by separate providers.

# Chat / function calling
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-chat-model

# Structured output (key and base URL both blank => inherit the LLM_* pair)
STRUCTURED_API_KEY=
STRUCTURED_BASE_URL=
STRUCTURED_MODEL=

# Embeddings (key and base URL both blank => inherit the LLM_* pair)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=replace-with-embedding-model

# Provider catalog health check. It never sends chat or embedding requests.
PROVIDER_HEALTH_TIMEOUT_SECONDS=5
PROVIDER_HEALTH_TTL_SECONDS=30
# Explicit CLI capability probes may make billable requests.
PROVIDER_CAPABILITY_TIMEOUT_SECONDS=30

# Local data and upload limits
CHROMA_DIR=./chroma_db
MAX_UPLOAD_MB=20
STAGING_COLLECTION_TTL_SECONDS=3600
DATABASE_URL=
# Maximum time spent waiting for another worker to finish learner-memory schema
# setup. This does not limit the migration itself.
MEMORY_STORE_SETUP_LOCK_TIMEOUT_SECONDS=300
MEMORY_SNAPSHOT_PATH=./.memory_snapshot.json
# Durable replay receipts and Autonomous pause snapshots use PostgreSQL when
# DATABASE_URL is set. Locally they share this SQLite file unless the optional
# AUTONOMOUS_SESSION_DB_PATH override is set.
IDEMPOTENCY_DB_PATH=./.idempotency.sqlite3
AUTONOMOUS_SESSION_DB_PATH=
AUTONOMOUS_SESSION_TTL_SECONDS=3600
AUTONOMOUS_SESSION_MAX_COUNT=200
AUTONOMOUS_SESSION_MAX_PAYLOAD_BYTES=2097152
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_PATH=./.checkpoints/orchestrator.db

# Retrieval features. Keep optional network/model-heavy stages off for first run.
QUERY_REWRITE_ENABLED=false
HYDE_ENABLED=false
MULTIQUERY_ENABLED=false
MULTIQUERY_N=3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Workflow switches
CRITIC_ENABLED=true
REVISER_ENABLED=true
PATH_REVISER_ENABLED=true
ONESHOT_QUIZ_CRITIC=true
MAS_SUPERVISOR_ENABLED=false
SUPERVISOR_MODE=llm

# Prompt-injection classifier; blank means regex-only checks.
INJECTION_LLM_CHECK=

# Optional live MCP tools. Disabled by default because they may access networks.
MCP_LIVE_ENABLED=false
UVX_PATH=uvx

# Optional tracing. Both integrations are disabled by default.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=study-loop
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Docker Compose development database. These are local demo values, not secrets.
POSTGRES_USER=studyloop
POSTGRES_PASSWORD=change-me-for-shared-environments
POSTGRES_DB=studyloop
