# Copy this file to .env, then replace provider placeholders locally.
# Never commit .env. OpenAI-compatible chat, structured-output, and embedding
# endpoints may be supplied by the same provider or by separate providers.

# Chat / function calling
LLM_API_KEY=replace-with-your-provider-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace-with-chat-model

# Structured output (key and base URL both blank => inherit the LLM_* pair)
STRUCTURED_API_KEY=
STRUCTURED_BASE_URL=
STRUCTURED_MODEL=

# Embeddings (key and base URL both blank => inherit the LLM_* pair)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=replace-with-embedding-model

# Provider catalog health check. It never sends chat or embedding requests.
PROVIDER_HEALTH_TIMEOUT_SECONDS=5
PROVIDER_HEALTH_TTL_SECONDS=30
# End-to-end budget for centralized retrying provider calls, including backoff.
PROVIDER_REQUEST_DEADLINE_SECONDS=60
# Explicit CLI capability probes may make billable requests.
PROVIDER_CAPABILITY_TIMEOUT_SECONDS=30

# Local data and upload limits
CHROMA_DIR=./chroma_db
MAX_UPLOAD_MB=20
STAGING_COLLECTION_TTL_SECONDS=3600
DATABASE_URL=
# With no DATABASE_URL, learner memory uses one in-process store plus this JSON
# snapshot and therefore supports exactly one backend worker. Configure
# PostgreSQL before starting multiple workers.
# Maximum time spent waiting for another worker to finish learner-memory schema
# setup. This does not limit the migration itself.
MEMORY_STORE_SETUP_LOCK_TIMEOUT_SECONDS=300
# Upper bound for one user's cross-worker session-write/archive lock.
MEMORY_SESSION_ARCHIVE_LOCK_TIMEOUT_SECONDS=10
MEMORY_SNAPSHOT_PATH=./.memory_snapshot.json
# Durable replay receipts, Web Quiz/Adaptive sessions, and Autonomous pause
# snapshots use PostgreSQL when DATABASE_URL is set. Locally they share this
# SQLite file unless a feature-specific path override is set.
IDEMPOTENCY_DB_PATH=./.idempotency.sqlite3
QUIZ_SESSION_DB_PATH=
QUIZ_SESSION_TTL_SECONDS=86400
QUIZ_SESSION_OPERATION_LEASE_SECONDS=600
QUIZ_SESSION_MAX_COUNT=500
QUIZ_SESSION_MAX_PAYLOAD_BYTES=2097152
ADAPTIVE_SESSION_DB_PATH=
ADAPTIVE_SESSION_TTL_SECONDS=3600
ADAPTIVE_SESSION_OPERATION_LEASE_SECONDS=600
ADAPTIVE_SESSION_MAX_COUNT=200
ADAPTIVE_SESSION_MAX_PAYLOAD_BYTES=2097152
ADAPTIVE_SESSION_PG_CONNECT_TIMEOUT_SECONDS=5
ADAPTIVE_SESSION_PG_LOCK_TIMEOUT_MS=5000
ADAPTIVE_SESSION_PG_STATEMENT_TIMEOUT_MS=15000
AUTONOMOUS_SESSION_DB_PATH=
AUTONOMOUS_SESSION_TTL_SECONDS=3600
AUTONOMOUS_SESSION_MAX_COUNT=200
AUTONOMOUS_SESSION_MAX_PAYLOAD_BYTES=2097152
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_PATH=./.checkpoints/orchestrator.db

# Retrieval features. Keep optional network/model-heavy stages off for first run.
QUERY_REWRITE_ENABLED=false
HYDE_ENABLED=false
MULTIQUERY_ENABLED=false
MULTIQUERY_N=3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Workflow switches
CRITIC_ENABLED=true
REVISER_ENABLED=true
PATH_REVISER_ENABLED=true
ONESHOT_QUIZ_CRITIC=true
# Experimental API-only supervisor graph. It has no Web UI and its pure tutor
# worker is unfinished. Keep false outside focused development/testing.
MAS_SUPERVISOR_ENABLED=false
SUPERVISOR_MODE=llm

# Prompt-injection classifier; blank means regex-only checks.
INJECTION_LLM_CHECK=

# Full audit payloads may contain user queries and retrieved document text.
# Keep disabled unless the API is restricted to a trusted environment.
AUDIT_PAYLOAD_ENABLED=false

# Optional live MCP tools. Disabled by default because they may access networks.
MCP_LIVE_ENABLED=false
UVX_PATH=uvx

# Optional tracing. Both integrations are disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=study-loop
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Blank uses the SDK cloud default and preserves legacy LANGFUSE_HOST fallback.
LANGFUSE_BASE_URL=

# Docker Compose database settings. POSTGRES_PASSWORD is required by Compose.
POSTGRES_USER=studyloop
POSTGRES_PASSWORD=
POSTGRES_DB=studyloop
